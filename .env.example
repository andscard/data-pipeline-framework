# Environment Variables Template

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pipeline_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_this_password

# Logging
LOG_LEVEL=INFO

# Airflow
AIRFLOW_FERNET_KEY=generate_with_cryptography_fernet
AIRFLOW_SECRET_KEY=generate_random_secret_key
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# ==========================================
# EXPERIMENTAL: Módulo de Seguridad (Tesis)
# ==========================================
# Estas variables solo se usan en el módulo de seguridad (src/modules/security/)
# No son necesarias para el pipeline principal

SIMULATION_MODE=false
DEFAULT_ATTACK_DELAY_MS=100
MAX_SIMULATION_DURATION_MINUTES=60
ENABLE_DESTRUCTIVE_ATTACKS=false
