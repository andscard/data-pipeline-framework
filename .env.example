# Template de variables de entorno
# Copiar este archivo a .env y personalizar los valores

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=data_framework
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=5540
REDIS_PASSWORD=your_secure_password_here

# Airflow
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_UID=50000

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Simulation Settings
SIMULATION_MODE=true
DEFAULT_ATTACK_DELAY_MS=100
MAX_SIMULATION_DURATION_MINUTES=60
ENABLE_DESTRUCTIVE_ATTACKS=false

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_password_here
